<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>View Posts - Mini SNS</title>
    <link rel="icon" type="image/png" href="Autumn.png" />
    <link rel="stylesheet" href="css/global.css"/>
    <link rel="stylesheet" href="css/post.css"/>
  </head>
  <body>
    <%-include("header")%>
    <h1>📜 Recent Posts</h1>

    <!-- Container for all posts -->
    <div class="post-list">
    <% posts.forEach(function(post){ %>
      <%-include("feed", {post: post})%>
      <% }); %>
          <div id="123">
        <a href="/write"> 
          <button >✍️ Write a post</button>
        </a>
      </div>
      <br />
    </div>
      <br/>
    
    <!--Link back to home-->
    <%-include("footer")%>
    </body>
    <script src="js/posts.js"></script>
</html>
